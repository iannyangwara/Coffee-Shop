# Copy to .env for local development (never commit .env).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://cafe:cafe@localhost:5432/cafe_platform
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourplatform.com
# TRUST_PROXY_HEADERS=1

# Photo storage (Cloudflare R2 or any S3-compatible bucket). Leave unset to store on local disk.
# MEDIA_BUCKET_NAME=
# MEDIA_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_DOMAIN=media.yourplatform.com
